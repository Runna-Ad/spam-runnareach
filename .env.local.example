# ============================================================
# S.P.A.M. — SAGA Opportunity Engine
# Environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Supabase (required — blocks Phase 0) ---
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard → Settings → General → Reference ID
SUPABASE_PROJECT_ID=

# --- Anthropic (required — blocks Phase 2) ---
# console.anthropic.com → API Keys
# Recommend $100/mo spend limit in Billing → Usage limits
ANTHROPIC_API_KEY=

# --- Google Cloud (required — blocks Phases 1 + 4) ---
# console.cloud.google.com → APIs & Services → Credentials
# OAuth client with redirect http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key restricted to Places API (New), HTTP referrer restriction
GOOGLE_PLACES_API_KEY=

# --- SAGA sending identity (blocks Phase 4 sending) ---
# Sender #1 SAGA principal — name before warming starts
# Secondary domain (e.g. sagareach.com, NOT runna.ca)
SAGA_FROM_EMAIL=
SAGA_SENDER_NAME=
SAGA_MAILING_ADDRESS=
# Physical mailing address required by CASL on every send

# --- Postmark (Phase 4 warming-period sends) ---
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# --- Cal.com (Phase 4.5) ---
CAL_COM_BOOKING_URL=
CAL_COM_WEBHOOK_SECRET=

# --- Slack hot-lead webhook (Phase 4) ---
SLACK_HOT_LEAD_WEBHOOK=

# --- Unipile LinkedIn (Phase 5) ---
UNIPILE_API_KEY=
UNIPILE_DSN=

# --- SerpAPI or similar (Phase 1) ---
SERPAPI_KEY=

# --- BuiltWith (Phase 1, optional) ---
BUILTWITH_API_KEY=

# --- Hunter.io (Phase 2, optional email verification) ---
HUNTER_API_KEY=

# --- Secrets — generate with `openssl rand -hex 32` ---
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=
