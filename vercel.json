{
  "functions": {
    "app/**": {
      "maxDuration": 60
    },
    "app/api/warmup/engine/route.ts": {
      "maxDuration": 120
    },
    "app/api/warmup/postmaster-sync/route.ts": {
      "maxDuration": 30
    },
    "app/api/pitches/follow-up/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/warmup/engine",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/warmup/postmaster-sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/pitches/follow-up",
      "schedule": "0 16 * * *"
    }
  ]
}
